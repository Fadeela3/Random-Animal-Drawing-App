<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <title>Animal Drawing App</title>
    <link rel="stylesheet" href="/templates/style.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
</head>
<body>
<section id="draw">
    <h1>Animal Drawing App</h1>

    <h2>Get Your Animal Prompt</h2>
    <div class="prompt-strip">
        <p>Your animal: <strong id="animal-display"></strong></p>
        <button class="btn-primary">🎲 Random Animal</button>
    </div>

    <h2>Draw It!</h2>
    <div class="canvas-wrap">
        <div class="toolbar">
            <span class="tool-group-label">Tool</span>
            <button class="tool-btn active" data-tool="pen">✏️</button>
            <button class="tool-btn" data-tool="eraser">🧹</button>

            <span class="tool-group-label">Color</span>
            <div class="swatches">
                <div class="color-swatch swatch-black selected" data-color="#2b2b2b"></div>
                <div class="color-swatch swatch-red"></div>
                <div class="color-swatch swatch-orange"></div>
                <div class="color-swatch swatch-yellow"></div>
                <div class="color-swatch swatch-green"></div>
                <div class="color-swatch swatch-blue"></div>
                <div class="color-swatch swatch-pink"></div>
                <div class="color-swatch swatch-purple"></div>
                <label class="color-swatch swatch-custom" title="Custom color">
                    <input type="color" id="custom-color" value="#ffffff"/>
                </label>
            </div>

            <span class="tool-group-label">Size</span>
            <input type="range" min="1" max="40" value="5"/>

            <span class="tool-group-label">Clear</span>
            <button class="tool-btn clear-btn">🗑️</button>
        </div>

        <canvas class="canvas-box" width="600" height="420"></canvas>
    </div>

    <h2>Add Your Details</h2>
    <div class="draw-form">
        <form action="/drawing" method="post">
            <div class="form-row">
                <div class="form-field">
                    <label>Title</label>
                    <input type="text" placeholder="My Magnificent Flamingo"/>
                </div>
                <div class="form-field">
                    <label>Your Name</label>
                    <input type="text" placeholder="Anonymous"/>
                </div>
            </div>
            <div class="form-field">
                <label>Message</label>
                <textarea placeholder="Tell us about your drawing…"></textarea>
            </div>
            <button class="btn-primary" type="submit">Upload to Gallery</button>
        </form>
    </div>
</section>
</body>
</html>