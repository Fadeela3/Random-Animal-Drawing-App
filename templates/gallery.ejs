<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Your Gallery</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="stylesheet" href="/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
</head>
<body>

  <!-- NAV -->
  <nav class="navbar">
    <a href="/" class="nav-logo">🎨 Animal Drawing App</a>
    <div class="nav-links">
      <a href="/drawing">Draw</a>
      <a href="/gallery" class="active">Gallery</a>
    </div>
  </nav>

  <!-- HEADER -->
  <header class="gallery-header">
    <h1 class="gallery-title">Your Gallery</h1>
    <p class="gallery-subtitle">A collection of unique creatures.</p>
  </header>

  <!-- GALLERY LIST -->
  <main class="gallery-list">
    <% if (drawings.length === 0) { %>
      <div class="empty-state">
        <p class="empty-emoji">🦕</p>
        <p>No drawings yet — be the first to contribute!</p>
        <a href="/drawing" class="btn-primary">Draw something</a>
      </div>
    <% } %>

    <% drawings.forEach(function(d) { %>
      <div class="gallery-row">
        <img class="gallery-img" src="<%= d.imageUrl || d.image %>" alt="Drawing of a <%= d.animalPrompt %>" />
        <div class="gallery-info">
          <h2 class="gallery-animal"><%= d.animalPrompt %></h2>
          <div class="gallery-details">
            <p><span class="detail-label">Title:</span> <%= d.title || 'Untitled' %></p>
            <p><span class="detail-label">Artist:</span> <%= d.artistName || d.author || 'Anonymous' %></p>
            <p><span class="detail-label">Message:</span> <%= d.message || '—' %></p>
          </div>
        </div>
      </div>
    <% }) %>

  </main>

  <footer class="site-footer">
    <p>Animal Drawing App — Where every animal deserves a portrait.</p>
    <a href="/" class="footer-cta">Pick up a pencil →</a>
  </footer>

</body>
</html>